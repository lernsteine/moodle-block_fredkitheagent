{{!
    @template block_fredkitheagent/design

    Look of the course chat: colours, texts and avatar of the course agent.

    Context variables required for this template:
    * url - This page
    * sesskey - Session key
    * colors - name, label, value
    * texts - name, label, value, placeholder
    * haslogo - Whether a course avatar exists
    * backurl - Course page

    Example context (json):
    {
        "url": "https://example.com/blocks/fredkitheagent/design.php?courseid=2",
        "sesskey": "abc",
        "colors": [{"name": "accentcolor", "label": "Accent", "value": "#007f91"}],
        "texts": [{"name": "welcometext", "label": "Welcome", "value": "", "placeholder": "Hello!"}],
        "haslogo": false,
        "backurl": "https://example.com/course/view.php?id=2"
    }
}}
<p>{{#str}} coursedesignintro, block_fredkitheagent {{/str}}</p>
<form method="post" action="{{url}}" enctype="multipart/form-data" class="fk-designform">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    {{#colors}}
    <div class="mb-3 d-flex align-items-center justify-content-between">
        <label for="fna-{{name}}">{{label}}</label>
        <input type="color" name="{{name}}" id="fna-{{name}}" value="{{value}}" class="form-control fk-colorinput">
    </div>
    {{/colors}}
    {{#texts}}
    <label for="fna-{{name}}">{{label}}</label>
    <input type="text" name="{{name}}" id="fna-{{name}}" value="{{value}}" maxlength="255" class="form-control" placeholder="{{placeholder}}" aria-describedby="fna-{{name}}-hint">
    <p class="text-muted small mt-1 mb-3" id="fna-{{name}}-hint">{{#str}} designglobalhint, block_fredkitheagent {{/str}}</p>
    {{/texts}}
    <label for="fna-logo">{{#str}} designcourselogo, block_fredkitheagent {{/str}}</label>
    <input type="file" name="courselogo" id="fna-logo" accept="image/png,image/jpeg,image/webp" class="form-control mb-2">
    <p class="text-muted small">{{#str}} designlogohint, block_fredkitheagent {{/str}}</p>
    {{#haslogo}}
    <div class="mb-3 form-check">
        <input type="checkbox" name="removelogo" value="1" id="fna-removelogo" class="form-check-input">
        <label for="fna-removelogo" class="form-check-label">{{#str}} designremovelogo, block_fredkitheagent {{/str}}</label>
    </div>
    {{/haslogo}}
    <button type="submit" class="btn btn-primary mt-3">{{#str}} savechanges {{/str}}</button>
</form>
<form method="post" action="{{url}}" class="mt-3">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="resetdesign" value="1">
    <button type="submit" class="btn btn-outline-secondary">{{#str}} designresetbutton, block_fredkitheagent {{/str}}</button>
</form>
<div class="mt-4"><a href="{{backurl}}">{{#str}} chatbackcourse, block_fredkitheagent {{/str}}</a></div>
