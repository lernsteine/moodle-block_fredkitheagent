{{!
    @template block_fredkitheagent/sync_form

    One POST form to sync.php. The big button and the quiet "full check" row share it.

    Context variables required for this template:
    * url - sync.php
    * courseid - Course id
    * sesskey - Session key
    * fullcheck - 1 for a full check, 0 otherwise
    * roleselect - Optional role select box
    * icon - Optional icon context
    * label - Button label
    * busylabel - Label while working
    * class - Button class

    Example context (json):
    {
        "url": "https://example.com/blocks/fredkitheagent/sync.php",
        "courseid": 2,
        "sesskey": "abc",
        "fullcheck": 0,
        "roleselect": false,
        "icon": {"refresh": true},
        "label": "Update",
        "busylabel": "Working …",
        "class": "fk-main"
    }
}}
<form method="post" action="{{url}}" data-fk-syncform="1">
    <input type="hidden" name="courseid" value="{{courseid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="fullcheck" value="{{fullcheck}}">
    {{#roleselect}}{{> block_fredkitheagent/role_select }}{{/roleselect}}
    <button type="submit" class="{{class}}" data-fk-label="{{label}}" data-fk-busylabel="{{busylabel}}">{{#icon}}{{> block_fredkitheagent/icon }}{{/icon}}<span class="fk-label">{{label}}</span></button>
</form>
