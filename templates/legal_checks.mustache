{{!
    @template block_fredkitheagent/legal_checks

    Required checkboxes for the terms, the privacy notice and the data processing agreement.

    Context variables required for this template:
    * checks - List of name and label (label contains links to the legal texts)

    Example context (json):
    {
        "checks": [{"name": "acceptterms", "label": "I accept the <a href=\"#\">terms</a>."}]
    }
}}
{{#checks}}
<div class="form-check mb-2">
    <input type="checkbox" name="{{name}}" value="1" id="fk-{{name}}" class="form-check-input" required>
    <label for="fk-{{name}}" class="form-check-label">{{{label}}}</label>
</div>
{{/checks}}
