{{!
    @template block_fredkitheagent/card_head

    Orb with eyes, plugin name and subtitle at the top of the cards.

    Context variables required for this template:
    * subtitle - Optional subtitle; the default subtitle is used when empty

    Example context (json):
    {
        "subtitle": "Course agent"
    }
}}
<div class="fk-head">
    <div class="fk-orb" aria-hidden="true"><span class="fk-eye"></span><span class="fk-eye"></span></div>
    <div class="fk-headcopy">
        <strong>{{#str}} pluginname, block_fredkitheagent {{/str}}</strong>
        <small>{{#subtitle}}{{.}}{{/subtitle}}{{^subtitle}}{{#str}} nextsubtitle, block_fredkitheagent {{/str}}{{/subtitle}}</small>
    </div>
</div>
