{{!
    @template block_fredkitheagent/quota

    Box shown from 80 % of the monthly messages.

    Context variables required for this template:
    * title - Heading
    * used - Messages used
    * limit - Messages per month
    * barlabel - Accessible label of the progress bar
    * text - Explanation
    * full - Whether all messages are used
    * link - Optional link (url, label)

    Example context (json):
    {
        "title": "160 of 200 messages used",
        "used": 160,
        "limit": 200,
        "barvalue": 160,
        "barlabel": "Messages used",
        "text": "The chat answers again from 1 December.",
        "full": false,
        "link": false
    }
}}
<div class="fk-quota{{#full}} is-full{{/full}}" role="status">
    <strong>{{title}}</strong>
    <progress class="fk-quotabar" max="{{limit}}" value="{{barvalue}}" aria-label="{{barlabel}}">{{used}} / {{limit}}</progress>
    <p>{{text}}</p>
    {{#link}}<a class="fk-main" href="{{url}}"{{#external}} target="_blank" rel="noopener"{{/external}}>{{label}}</a>{{/link}}
</div>
