{{!
    @template block_fredkitheagent/card_inactive

    Card shown to teachers while the Moodle site is not yet activated at the licence server.

    Context variables required for this template:
    * isadmin - Whether the viewer may open the activation page
    * activationurl - The activation page

    Example context (json):
    {
        "isadmin": true,
        "activationurl": "https://example.com/blocks/fredkitheagent/activation.php"
    }
}}
<div class="fredki-next-card fredki-ios fk-inactive">
    {{> block_fredkitheagent/card_head }}
    <div class="fk-status is-waiting"><span class="fk-dot is-waiting"></span>{{#str}} iosinactivestatus, block_fredkitheagent {{/str}}</div>
    <p class="fk-intro">{{#str}} iosinactiveintro, block_fredkitheagent {{/str}}</p>
    {{#isadmin}}
    <a class="fk-main" href="{{activationurl}}">{{#icon}}{{> block_fredkitheagent/icon }}{{/icon}}{{#str}} iosinactiveopen, block_fredkitheagent {{/str}}</a>
    <div class="fk-caption">{{#str}} iosinactivetrial, block_fredkitheagent {{/str}}</div>
    {{/isadmin}}
    {{^isadmin}}
    <div class="fk-note">{{#str}} iosinactivenoadmin, block_fredkitheagent {{/str}}</div>
    {{/isadmin}}
</div>
