{{!
    @template block_fredkitheagent/role_select

    Select box with the agent roles offered by the licence server.

    Context variables required for this template:
    * wrapclass - CSS class of the wrapper
    * id - Id of the select box
    * options - List of value, label, title, selected

    Example context (json):
    {
        "wrapclass": "fk-rolepick",
        "id": "fredki-role-2-1234",
        "options": [{"value": "berater", "label": "Berater", "title": "Advises", "selected": true}]
    }
}}
<div class="{{wrapclass}}">
    <label for="{{id}}">{{#str}} rolelabel, block_fredkitheagent {{/str}}</label>
    <select name="agentrole" id="{{id}}" class="fk-roleselect">
        {{#options}}<option value="{{value}}"{{#title}} title="{{.}}"{{/title}}{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
    </select>
</div>
